{
  "name": "financial",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run extension:prepare",
    "prebuild": "npm run extension:prepare",
    "extension:prepare": "tsx scripts/prepare-extension.ts",
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:boursosync:db": "node scripts/test-boursosync-db.mjs",
    "test:comparison:db": "node scripts/test-comparison-db.mjs",
    "test:market-sync:db": "node scripts/test-manual-market-sync-db.mjs",
    "market:sync": "tsx scripts/sync-market.ts",
    "market:check": "tsx scripts/sync-market.ts --dry-run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.80.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.4.0",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "3.6.4",
    "linkedom": "0.18.12",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
