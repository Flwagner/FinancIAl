{
  "manifest_version": 3,
  "name": "Boursosync · FinancIAl",
  "version": "3.2.2",
  "minimum_chrome_version": "116",
  "description": "Lecture volontaire des montants BoursoBank et synchronisation ciblée vers FinancIAl.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://mhqemvbbocaiwtuairen.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup/popup.html",
    "default_title": "Boursosync"
  }
}
